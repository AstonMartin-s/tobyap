# --- Base de datos (Postgres / Vercel Postgres / Neon / Supabase) ---
DATABASE_URL="postgres://user:pass@host:5432/tobyap"

# --- Cifrado de secretos en DB (AES-256-GCM) ---
# 32 bytes en hex (64 chars). Generala una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Alta de tenants (endpoint admin) ---
ADMIN_TOKEN=""

# --- Sesión del panel (firma de cookie) ---
# 32 bytes hex, mismo método que ENCRYPTION_KEY
SESSION_SECRET=""

# --- Meta (solo desarrollo): ver eventos en "Eventos de prueba" sin impactar atribución ---
META_TEST_EVENT_CODE=""

# --- API resolve (CRM Main consume GET /api/v1/resolve) ---
# Si está vacía, el endpoint queda abierto. Fase 2.1 lo hará obligatorio en prod.
# Avisar R1 a CRM Main ANTES de exigirla.
RESOLVE_API_KEY=""
# Opcional: códigos más viejos que N días → 404. 0 / vacío = sin TTL.
RESOLVE_TTL_DAYS=""

# --- Cron de reintentos CAPI (POST /api/cron/retry) ---
# Si está seteada, exige Authorization: Bearer <CRON_SECRET>. Fase 2.5 la hará obligatoria.
CRON_SECRET=""

# --- WA checker (verificación de WhatsApp al iniciar chat) ---
WACHECK_URL=""
WACHECK_TOKEN=""

# --- Comprobantes en disco (vacío = no persiste archivo; sigue en DB) ---
UPLOAD_DIR=""

# --- Schedulers in-process (instrumentation-node.ts). 1 = apagar ese loop ---
# En Railway con >1 réplica: dejar UNO solo, o DISABLE_*=1 + cron externo único (Fase 6).
DISABLE_RETRY_SCHEDULER="0"
DISABLE_REMINDERS="0"
DISABLE_AUTOCLOSE="0"
DISABLE_PURGE="0"
DISABLE_COMPROBANTE_CLEANUP="0"
# Intervalos opcionales (ms / horas)
# RETRY_INTERVAL_MS=600000
# AUTOCLOSE_HOURS=72
# PURGE_HOURS=24
# COMPROBANTE_CLEANUP_HOURS=48

# --- Fase 1 emitCargo: panel approve → CargoCRM. Default ON. 0 = comportamiento viejo (sin CAPI). ---
EMIT_CARGO_FROM_PANEL="1"

# --- Fase 2 hardening (opt-in; default no rompe prod) ---
# 2.1 fail-boot si falta RESOLVE_API_KEY. No activar hasta que Aston avise al consumidor.
REQUIRE_RESOLVE_API_KEY="0"
# 2.2 exigir ?client=<slug>. El caller hoy puede no mandarlo. Warning en logs hasta activar.
REQUIRE_RESOLVE_CLIENT="0"
# 2.3 secret por tenant. Vacío = webhook abierto (hoy). King: setear y agregar ?secret= en Kommo.
# KOMMO_WEBHOOK_SECRET_KING=""
# 2.4 /api/test/capi ya 404 en production. Emergencia:
ALLOW_TEST_CAPI="0"
# 2.5 exigir CRON_SECRET aunque no esté seteado (cierra el cron).
REQUIRE_CRON_SECRET="0"
# 2.6 HMAC comprobantes. TTL del token nuevo; sessionKey solo vive N días.
FILE_SIGNING_SECRET=""
FILE_TOKEN_TTL_SEC="172800"
FILE_LEGACY_DAYS="14"
APP_PUBLIC_URL="https://tobyap-production.up.railway.app"
# 2.7 rate limit. 0 en RATE_LIMIT apaga todo.
RATE_LIMIT="1"
RATE_LIMIT_REDIRECT="60"
RATE_LIMIT_CHAT_START="20"
