{
  "name": "tobyap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:tenant": "tsx --env-file=.env scripts/seed-tenant.ts",
    "import:paybot": "tsx --env-file=.env scripts/import-paybot-events.ts",
    "import:send-list": "tsx --env-file=.env scripts/import-send-list.ts",
    "heal-client": "tsx --env-file=.env scripts/heal-client.ts",
    "seed-meta": "tsx --env-file=.env scripts/seed-meta-event.ts",
    "onboard": "tsx --env-file=.env scripts/onboard-client.ts",
    "provision": "tsx --env-file=.env scripts/provision-client.ts",
    "bot-spec": "tsx --env-file=.env scripts/bot-spec.ts",
    "adapt-bots": "tsx --env-file=.env scripts/adapt-bots.ts",
    "smoke:wiring": "tsx --env-file=.env scripts/smoke-wiring.ts",
    "smoke:db": "tsx --env-file=.env scripts/smoke-db.ts",
    "smoke:concurrency": "tsx --env-file=.env scripts/smoke-concurrency.ts",
    "smoke": "npm run typecheck && npm run smoke:wiring && npm run smoke:db"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "heic-convert": "^2.1.0",
    "next": "^14.2.33",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
